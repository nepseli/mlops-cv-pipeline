# Copy to .env and fill in. .env is gitignored — your account-specific values
# never enter version control, and no tracked file is ever rewritten.
#
#   cp .env.example .env && $EDITOR .env
#
# `./infra/bootstrap-aws.sh <account-id>` prints these values ready to paste.

AWS_ACCOUNT_ID=123456789012
AWS_REGION=us-east-1

# Container registry host — derived from the two values above.
ECR=123456789012.dkr.ecr.us-east-1.amazonaws.com

# S3 buckets created by bootstrap-aws.sh (globally unique, so they carry a suffix).
DVC_BUCKET=mlops-cv-dvc-789012
MLFLOW_BUCKET=mlops-cv-mlflow-789012

# Local-only Grafana admin password. Change it; never commit the real one.
GRAFANA_ADMIN_PASSWORD=change-me

# Image tag applied to builds and deploys.
IMAGE_TAG=latest
